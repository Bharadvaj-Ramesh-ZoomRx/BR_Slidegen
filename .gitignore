# ── Project data files (input, context, templates, output per project) ───────
# All proprietary content lives under projects/<name>/ subdirectories.
projects/*/input/
projects/*/context/
projects/*/templates/
projects/*/output/
projects/*/config_history/
projects/*/config.yaml

# ── Generated output files ───────────────────────────────────────────────────
output/
slidegen/output/
slidegen/slide_registry.json

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── Office temp files ────────────────────────────────────────────────────────
~$*

# ── Obsidian ────────────────────────────────────────────────────────────────
.obsidian/

# ── Temp / test artifacts ────────────────────────────────────────────────────
test_*.pptx
output_deck.pptx
*.tmp
archive/pptx.zip
tests/test_project/config_history/
tests/test_project/output/

# ── Claude Code auto-memory (session-specific) ──────────────────────────────
.claude/*
!.claude/skills/

# ── OS files ─────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
nul

# ── Environment / secrets ────────────────────────────────────────────────────
.env

# ── Experiments (reverse-engineering decks — not committed) ─────────────────
experiments/deck_analysis/decks/*
experiments/deck_analysis/outputs/generated/*
!experiments/deck_analysis/decks/.gitkeep
!experiments/deck_analysis/outputs/.gitkeep

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# Generated test output (reproducible from specs; don't track binaries)
experiments/deck_analysis/outputs/generated/*.pptx
tests/track1/*.pptx
tests/track3/*.pptx
tests/UAT_dummy_data.pptx
tests/UAT_refreshed_from_spec.pptx
tests/UAT_intelligent_refresh.pptx
tests/UAT_deck_config_specs.json
projects/*

# OneDrive archives
*.zip

# synapse data loader (auto-generated, not manually authored)
slidegen/pipeline/synapse_data_loader.py
experiments/deck_analysis/outputs/
output.pptx
