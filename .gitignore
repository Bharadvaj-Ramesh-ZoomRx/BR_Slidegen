# ── Project data files (data, templates, output, reference per project) ──────
# All proprietary content lives under projects/<name>/ subdirectories.
projects/*/data/
projects/*/templates/
projects/*/output/
projects/*/reference/

# ── Generated output files ───────────────────────────────────────────────────
output/
slidegen/output/
slidegen/slide_registry.json

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── Office temp files ────────────────────────────────────────────────────────
~$*

# ── Temp / test artifacts ────────────────────────────────────────────────────
test_*.pptx
output_deck.pptx
*.tmp
archive/pptx.zip

# ── Claude Code auto-memory (session-specific) ──────────────────────────────
.claude/

# ── OS files ─────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
nul

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
