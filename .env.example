# Synapse API Authentication
# Option 1: Static token (for dev — when Synapse server has auth mocked)
# SYNAPSE_API_KEY=dev

# Option 2: Azure AD auto-token (for production — auto-acquires + caches)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-registration-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_SCOPE=api://your-client-id/.default